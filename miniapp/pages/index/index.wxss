.header { background: linear-gradient(135deg, #1a1a2e, #e2720c); color: #fff; padding: 30rpx 0; text-align: center; }
.header-title { font-size: 36rpx; font-weight: 700; letter-spacing: 4rpx; }
.header-sub { font-size: 24rpx; opacity: .85; margin-top: 10rpx; }
.container { padding: 20rpx; }

/* Stats */
.stats { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.stat-card { background: #fff; padding: 20rpx 24rpx; border-radius: 14rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); text-align: center; flex: 1; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #e2720c; }
.stat-label { font-size: 20rpx; color: #888; margin-top: 4rpx; }

/* Search */
.search-box { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,.06); }
.mode-tabs { display: flex; gap: 8rpx; margin-bottom: 20rpx; background: #f5f5f5; border-radius: 12rpx; padding: 6rpx; }
.mode-tab { flex: 1; padding: 16rpx 10rpx; border-radius: 10rpx; text-align: center; font-size: 26rpx; color: #666; }
.mode-tab.active { background: #fff; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.08); color: #e2720c; font-weight: 700; }
.search-row { display: flex; gap: 12rpx; align-items: center; }
.search-input { flex: 1; padding: 18rpx 24rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; font-size: 28rpx; }
.brand-picker { padding: 18rpx 20rpx; border: 2rpx solid #e0e0e0; border-radius: 12rpx; background: #fff; min-width: 160rpx; }
.picker-text { font-size: 26rpx; color: #333; }
.btn-search { padding: 18rpx 32rpx; background: #e2720c; color: #fff; border: none; border-radius: 12rpx; font-size: 26rpx; font-weight: 600; }
.btn-reset { padding: 18rpx 24rpx; background: #fff; color: #e2720c; border: 2rpx solid #e2720c; border-radius: 12rpx; font-size: 24rpx; }

/* Cards */
.result-summary { font-size: 26rpx; color: #666; margin-bottom: 16rpx; }
.highlight { color: #e2720c; font-weight: 700; }
.card { background: #fff; border-radius: 18rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05); border-left: 6rpx solid transparent; }
.match-card { border-left-color: #22c55e; }
.card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16rpx; }
.card-title { font-size: 30rpx; font-weight: 700; color: #1a1a2e; }
.card-brand { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.card-specs { display: flex; flex-wrap: wrap; gap: 6rpx 24rpx; }
.spec-row { width: 45%; font-size: 24rpx; margin-bottom: 4rpx; }
.spec-label { color: #888; }
.spec-value { font-weight: 600; color: #333; }

/* Badges */
.src-badge { display: inline-block; padding: 2rpx 10rpx; border-radius: 10rpx; font-size: 18rpx; margin-left: 6rpx; }
.src-badge.src-high { background: #dcfce7; color: #16a34a; }
.src-badge.src-mid { background: #fef3c7; color: #d97706; }
.src-badge.src-low { background: #fee2e2; color: #dc2626; }
.power-tag { display: inline-block; padding: 4rpx 14rpx; border-radius: 16rpx; font-size: 20rpx; }
.power-tag.power-high { background: #fee2e2; color: #dc2626; }
.power-tag.power-mid { background: #fef3c7; color: #d97706; }
.power-tag.power-low { background: #dbeafe; color: #2563eb; }
.match-badge { display: inline-block; padding: 4rpx 16rpx; border-radius: 16rpx; font-size: 20rpx; font-weight: 600; }
.match-badge.fit { background: #dcfce7; color: #16a34a; }
.match-badge.nofit { background: #fee2e2; color: #dc2626; }

/* Battery list */
.card-note { font-size: 22rpx; color: #888; margin-top: 12rpx; background: #fff8f3; padding: 10rpx 16rpx; border-radius: 10rpx; }
.card-battery-list { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.battery-label { font-size: 22rpx; color: #888; margin-bottom: 6rpx; }
.battery-item { font-size: 22rpx; color: #666; margin: 4rpx 0; }
.batt-name { font-weight: 700; color: #e2720c; }
.more-hint { font-size: 20rpx; color: #e2720c; }
.card-no-match { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; color: #ef4444; font-size: 22rpx; }
.card-warning { font-size: 20rpx; color: #ef4444; margin-top: 10rpx; }

/* Empty */
.empty { text-align: center; padding: 100rpx 20rpx; color: #999; font-size: 26rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }

/* Modal */
.modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5); z-index: 1000; }
.modal-overlay.show { display: flex; justify-content: center; align-items: center; }
.modal { background: #fff; border-radius: 24rpx; padding: 36rpx; width: 90%; max-height: 85vh; overflow-y: auto; }
.modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.modal-title { font-size: 34rpx; font-weight: 700; color: #1a1a2e; }
.modal-close { background: none; border: none; font-size: 40rpx; color: #999; padding: 10rpx; }
.modal-brand { font-size: 22rpx; color: #888; margin-bottom: 20rpx; }
.modal-specs { display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; margin-bottom: 20rpx; }
.mspec { width: 45%; font-size: 24rpx; }
.mspec-label { font-weight: 600; }
.modal-note { font-size: 22rpx; background: #fff8f3; padding: 12rpx 18rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.modal-divider { height: 1rpx; background: #f0f0f0; margin: 20rpx 0; }
.modal-batt-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.no-match { color: #ef4444; font-size: 24rpx; }
.modal-batt-item { padding: 18rpx; margin: 10rpx 0; background: #f8fdf8; border-radius: 14rpx; border-left: 5rpx solid #22c55e; }
.mbi-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.mbi-name { font-size: 26rpx; font-weight: 700; color: #e2720c; }
.mbi-info { font-size: 22rpx; color: #666; }
.mbi-extra { font-size: 20rpx; color: #888; margin-top: 4rpx; }
.modal-warning { font-size: 22rpx; color: #d97706; margin-top: 16rpx; }

/* Reset button style */
button { margin: 0; padding: 0; line-height: 1.4; }
button::after { border: none; }
